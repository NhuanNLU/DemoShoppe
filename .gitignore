##########################################################################
# .gitignore - Enterprise .NET Backend
# Áp dụng cho: ASP.NET Core Web API, Worker Service, Class Library,
#              EF Core, Docker, CI/CD, Visual Studio, Rider, VS Code
##########################################################################

##########################################################################
# 1. SECRETS & BIẾN MÔI TRƯỜNG (QUAN TRỌNG NHẤT - KHÔNG BAO GIỜ COMMIT)
##########################################################################
# Environment files
.env
.env.*
!.env.example
!.env.template
*.env

# Cấu hình chứa thông tin nhạy cảm theo máy / môi trường
# LƯU Ý: appsettings.json và appsettings.{Environment}.json KHÔNG bị ignore
# (chỉ chứa cấu hình không nhạy cảm). Secrets phải dùng User Secrets,
# Azure Key Vault, AWS Secrets Manager, HashiCorp Vault hoặc CI/CD variables.
appsettings.Local.json
appsettings.*.Local.json
appsettings.Development.Local.json
appsettings.Secrets.json
appsettings.Production.json.local
secrets.json
secrets.*.json
launchSettings.local.json

